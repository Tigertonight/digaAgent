{
  "name": "diga-agent",
  "version": "0.1.2",
  "description": "Diga Agent: self-hosted coding agent UI for Web and Electron.",
  "license": "MIT",
  "keywords": [
    "diga",
    "diga-agent",
    "ai",
    "agent",
    "claude",
    "openai",
    "llm",
    "self-hosted",
    "ui",
    "nextjs"
  ],
  "bin": {
    "diga-agent": "bin/diga-agent.js"
  },
  "//main-comment": "electron 入口仅本地开发使用；用 scripts 显式传入而不写 main，避免 npm publish 把 electron/main.js 打进 tarball。",
  "files": [
    "bin/",
    ".next/server/",
    ".next/static/",
    ".next/BUILD_ID",
    ".next/app-path-routes-manifest.json",
    ".next/build-manifest.json",
    ".next/export-marker.json",
    ".next/fallback-build-manifest.json",
    ".next/images-manifest.json",
    ".next/next-minimal-server.js.nft.json",
    ".next/next-server.js.nft.json",
    ".next/package.json",
    ".next/prerender-manifest.json",
    ".next/react-loadable-manifest.json",
    ".next/required-server-files.js",
    ".next/required-server-files.json",
    ".next/routes-manifest.json",
    "lib/workflows/script-worker-child.cjs",
    "public/",
    "next.config.ts",
    "next.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "DIGA_AGENT_NO_STANDALONE=1 next build --webpack",
    "patch:next": "node scripts/patch-next.mjs",
    "build:electron": "node scripts/patch-next.mjs && next build --webpack && node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "design-tokens:check": "node scripts/check-design-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "public-surface:check": "node scripts/check-public-surface.mjs",
    "internal-runtime:check": "node scripts/check-internal-runtime.mjs",
    "workflow:sandbox:check": "node scripts/check-workflow-sandbox.mjs",
    "route-auth:check": "node scripts/check-route-auth.mjs",
    "electron:dev": "ELECTRON_DEV=1 electron electron/main.js",
    "electron:start": "electron electron/main.js",
    "clean": "rm -rf dist .next",
    "electron:build": "npm run clean && npm run build:electron && node scripts/build-electron.mjs --mac --arm64",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:smoke:ci": "node scripts/release-smoke.mjs --dry-run",
    "ci:quality": "npm run lint && npm run typecheck && npm test && npm run route-auth:check && npm run workflow:sandbox:check && npm run public-surface:check && npm run internal-runtime:check",
    "ci:release": "npm run ci:quality && npm run electron:build && npm run release:smoke:ci"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.78.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@lobehub/icons": "^5.10.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "playwright": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "io.diga.agent",
    "productName": "Diga Agent",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/standalone/node_modules/**/*",
      ".next/standalone/.next/**/*",
      ".next/static/**/*",
      "lib/workflows/script-worker-child.cjs",
      "public/**/*",
      "package.json",
      "!**/.DS_Store",
      "!**/*.map",
      "!**/docs/**",
      "!**/examples/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.md",
      "!**/*.tsbuildinfo"
    ],
    "asarUnpack": [
      "**/*.node",
      "electron/server-wrapper.js",
      "node_modules/keytar/**/*",
      "**/.next/standalone/node_modules/@earendil-works/pi-coding-agent/**/*"
    ],
    "afterPack": "scripts/electron-after-pack.mjs",
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "build/trayIconSource.png",
        "to": "trayIconSource.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": false,
      "contents": [
        {
          "x": 140,
          "y": 150,
          "type": "file"
        },
        {
          "x": 420,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 140,
          "y": 330,
          "type": "file",
          "path": "build/1-安装前必读.txt"
        }
      ]
    },
    "npmRebuild": false
  }
}
