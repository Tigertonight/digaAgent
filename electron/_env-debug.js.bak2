const path = require('node:path');
process.chdir(path.join(__dirname, '..'));
const settingsModule = require('./settings');

(async () => {
  const keytarEnv = await settingsModule.buildEnvFromKeytar();
  const serverFile = path.join(process.cwd(), '.next/standalone/server.js');
  const port = 12346;

  const mergedEnv = {
    ...process.env,
    ...Object.fromEntries(
      Object.values(settingsModule.PROVIDER_ENV_MAP).flat().map((n) => [n, undefined])
    ),
    ...keytarEnv,
    PORT: String(port),
    HOSTNAME: "127.0.0.1",
    DIGA_AGENT_WEB_ROOT: process.env.HOME,
    NODE_ENV: "production",
    DIGA_AGENT_SERVER_ENTRY: serverFile,
    DIGA_AGENT_PARENT_PID: String(process.pid),
  };
  for (const [k, v] of Object.entries(mergedEnv)) {
    if (v === undefined) delete mergedEnv[k];
  }
  // 比较 mergedEnv 和 process.env 的差异
  const allKeys = new Set([...Object.keys(process.env), ...Object.keys(mergedEnv)]);
  console.log('Δ keys:');
  for (const k of allKeys) {
    if (process.env[k] !== mergedEnv[k]) {
      console.log(' ', k, ':', JSON.stringify(process.env[k]?.slice?.(0,30)), '->', JSON.stringify(mergedEnv[k]?.slice?.(0,30)));
    }
  }

  // 用同样 env fork wrapper 看会不会出错
  const { fork } = require('node:child_process');
  const child = fork(path.join(process.cwd(), 'electron/server-wrapper.js'), [], {
    env: mergedEnv,
    stdio: ['ignore', 'inherit', 'inherit', 'ipc'],
  });
  setTimeout(() => {
    child.kill();
    process.exit(0);
  }, 5000);
})();
